# Project configuration; no dependency on personal ~/.xschem settings.
set THESIS_ROOT [file dirname [file normalize [info script]]]
set PDK_ROOT $env(PDK_ROOT)
set PDK $env(PDK)
source $PDK_ROOT/$PDK/libs.tech/xschem/xschemrc
# Keep the IHP welcome page supplied by the PDK.
set netlist_dir $THESIS_ROOT/build/netlist
file mkdir $netlist_dir
append XSCHEM_LIBRARY_PATH :$THESIS_ROOT/design/top/schematic
foreach block [glob -nocomplain -types d $THESIS_ROOT/design/blocks/*] {
    append XSCHEM_LIBRARY_PATH :$block/schematic
}
append XSCHEM_LIBRARY_PATH :$THESIS_ROOT/verification/testbenches
set INITIALINSTDIR $THESIS_ROOT/design
