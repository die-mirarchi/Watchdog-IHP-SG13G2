let ok = ok & p7
echo RESULT_BEGIN
print d0 d1 d2 d3 d4 d5 d6 d7
print ph0 ph1 ph2 ph3 ph4 ph5 ph6 ph7
print q0 q1 q2 q3 q4 q5 q6 q7
print a0 a1 a2 a3 a4 a5 a6 a7
print p0 p1 p2 p3 p4 p5 p6 p7 ok
echo RESULT_END
if ok > 0.5
  echo VEREDICTO: PASS
else
  echo VEREDICTO: FAIL
end
plot v(clk) v(por_raw_n) v(xdut.p1)+1.5 v(porb)+3
.endc
.end
