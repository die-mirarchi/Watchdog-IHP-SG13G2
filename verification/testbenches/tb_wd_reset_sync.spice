+ 0.00250000235 0 0.002500002375 0.001 0.0025000024 0 0.002500002425 0.001 0.00250000245 0 0.002500002475 0.001 0.0025000025 0 0.002500002525 0.001
+ 0.00250000255 0 0.002500002575 0.001 0.0025000026 0 0.002500002625 0.001 0.00250000265 0 0.002500002675 0.001 0.0025000027 0 0.002500002725 0.001
+ 0.00250000275 0 0.002500002775 0.001 0.0025000028 0 0.002500002825 0.001 0.00250000285 0 0.002500002875 0.001 0.0025000029 0 0.002500002925 0.001
+ 0.00250000295 0 0.002500002975 0.001 0.002500003 0)
