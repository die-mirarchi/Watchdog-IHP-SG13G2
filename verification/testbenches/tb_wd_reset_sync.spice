let ph0 = (tP0 - 50u) - T*floor((tP0 - 50u)/T + 0.5)
let q0 = (tP0 - tQ0 - T)
let a0 = tF0 - 0.00039
let p0 = (tP0 gt 0) & (d0 ge 0.999) & (d0 le 2.0005) & (ph0 ge 0) & (ph0 le 20n) & (abs(q0) le 20n) & (tG0 lt 0) & (tF0 gt 0) & (a0 le 100n)
let ok = ok & p0
