* carga de PORB: R_B de ~25 FF + XOUT + cableado
CPORB PORB 0 100f

.control
tran 1n 2500u 0 100n
let T = 100u
let VM = 1.2/2
let ok = 1
* --- segmento 0: delta = -50u ---
let tP0=-1
let tQ0=-1
let tG0=-1
let tF0=-1
meas tran tP0 when v(porb)=VM rise=1 from=0.0001 to=0.000385
meas tran tQ0 when v(xdut.p1)=VM rise=1 from=0.0001 to=0.000385
meas tran tG0 when v(porb)=VM rise=2 from=0.0001 to=0.000385
meas tran tF0 when v(porb)=VM fall=1 from=0.00039 to=0.000395
