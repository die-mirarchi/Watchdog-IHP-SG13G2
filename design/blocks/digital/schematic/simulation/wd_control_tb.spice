*.opin BOOT
*.ipin CLK
*.ipin T10
*.ipin T00
*.ipin Q10_N
*.ipin WDI_EDGE
x1 CFG0 SET0 POR_B HI VDD VSS sg13g2_dllrq_1
x2 CFG1 SET1 POR_B HI VDD VSS sg13g2_dllrq_1
x4 DIS CFG0 CFG1 VDD VSS sg13g2_and2_2
x3 NBA WDI_EDGE ACTIVE NB VDD VSS sg13g2_a21o_1
x5 NBD NBA RS_N VDD VSS sg13g2_and2_1
x6 NB BOOT CLK NBD POR_B VDD VSS sg13g2_dfrbp_1
x7 OR3 DIS WDI_EDGE HIT VDD VSS sg13g2_or3_1
x8 net1 OR3 T01 RESET VDD VSS sg13g2_mux2_2
x9 CLR net1 VDD VSS sg13g2_buf_16
x10 TON T00 T01 T10 LO CFG0 CFG1 VDD VSS sg13g2_mux4_1
x11 TO T10 TON NB VDD VSS sg13g2_mux2_1
x12 HIT ACTIVE TO WE_N VDD VSS sg13g2_and3_2
x13 WE_N WDI_EDGE VDD VSS sg13g2_inv_1
x14 ACTIVE DIS RESET VDD VSS sg13g2_nor2_2
x15 RSD RESET Q10_N HIT VDD VSS sg13g2_a21o_1
x16 RESET RS_N CLK RSD POR_B VDD VSS sg13g2_dfrbp_2
x17 LO VDD VSS sg13g2_tielo
