** sch_path: /workspace/design/blocks/por/schematic/wd_reset_sync_tb.sch
**.subckt wd_reset_sync_tb
x1 POR_RAW_N VDD VSS wd_por
x2 POR_RAW_N CLK POR_B VDD VSS wd_reset_sync
x3 CLK VDD VSS wd_oscillater
C1 POR_B VSS 50f
**** begin user architecture code



.lib cornerMOSlv.lib mos_tt
.lib cornerMOShv.lib mos_tt
.lib cornerHBT.lib hbt_typ
.lib cornerRES.lib res_typ
.lib cornerDIO.lib dio_tt
.lib cornerCAP.lib cap_typ





.param vdd=1.2
.temp 27
.option method=gear maxord=2 reltol=1e-3
** fuentes
VVDD VDD 0 PULSE(0 {vdd} 1u 1u 0.1u 300u 600u)
VVSS VSS 0 DC 0
.control
  set num_threads=1
  * ---- TRAN ----
  tran 50n 310u
  let idd = -1
  meas tran idd AVG i(VVDD)
  let idd_ua = -1
  if (idd ne -1)
    let idd_ua = -idd*1e6
  end
  echo '  idd_ua = $&idd_ua'
  plot v(VDD)
  plot -i(VVDD)*1e6
  write wd_reset_sync_tb.raw
.endc


**** end user architecture code
**.ends

