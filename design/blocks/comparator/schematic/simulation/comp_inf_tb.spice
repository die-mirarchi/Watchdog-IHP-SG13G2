XM7 net4 VP net3 VDD sg13_lv_pmos w=40u l=0.5u ng=5 m=1 mm_ok=1
XM8 net1 VN net3 VDD sg13_lv_pmos w=40u l=0.5u ng=5 m=1 mm_ok=1
XM9 net4 net4 VSS VSS sg13_lv_nmos w=4u l=1u ng=3 m=1 mm_ok=1
